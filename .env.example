# ============================================================
# Prompt-Injection Tester - Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

# --- Application ---
APP_NAME=Prompt-Injection Tester
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ---
DATABASE_URL=sqlite:///./prompt_inject.db
# For PostgreSQL (e.g. docker compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/prompt_inject

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM Configuration ---
# Provider: "groq" | "openai" | "mock" | "none"
# Option A: With Groq (fast & high quality)
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL=llama-3.3-70b-versatile
# ATTACK_MODEL=llama-3.3-70b-versatile
#
# Option B: With OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# JUDGE_MODEL=gpt-4o-mini
# ATTACK_MODEL=gpt-4o-mini
#
# Option C: Offline / No API Key (uses rule engine + deterministic fallback)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
JUDGE_MODEL=gpt-4o-mini
ATTACK_MODEL=gpt-4o-mini

# --- Embeddings ---
# Provider: "sentence-transformers" | "openai" | "none"
# Note: Groq does not host embeddings, so keep this as "none" or "sentence-transformers"
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Scan Limits ---
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=30
MAX_ATTACKS=200
DEFAULT_RATE_LIMIT=10
ATTACK_GEN_TIMEOUT=60
ATTACK_GEN_MAX_RETRIES=2
MAX_GENERATED_ATTACKS=25
MAX_RESPONSE_LENGTH=200000

# --- SSRF Protection ---
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOW_LOCALHOST_DEV=true

# --- Admin ---
API_AUTH_ENABLED=false
API_USERNAME=admin
API_PASSWORD=change-me

# --- Frontend ---
FRONTEND_PORT=5173